{
  "expo": {
    "name": "Tiked",
    "slug": "clubhive",
    "scheme": "tiked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clubhive.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "Tiked",
        "CFBundleName": "Tiked",
        "GIDClientID": "1014451974721-f1q2t7kl9t20rp0g3n5v5tqhbd0q7vn3.apps.googleusercontent.com",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Tiked usa tu ubicación para mostrarte los eventos que hay cerca de ti.",
        "NSPhotoLibraryUsageDescription": "Tiked usa tus fotos para tu foto de perfil.",
        "NSPhotoLibraryAddUsageDescription": "Tiked guarda tu foto de perfil en este dispositivo.",
        "NSCameraUsageDescription": "Tiked usa la cámara para tu foto de perfil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.clubhive.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withIosModularHeaders",
      "./plugins/withIosDeploymentTarget",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1014451974721-f1q2t7kl9t20rp0g3n5v5tqhbd0q7vn3"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tiked usa tus fotos para tu foto de perfil.",
          "cameraPermission": "Tiked usa la cámara para tu foto de perfil."
        }
      ],
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tiked usa tu ubicación para mostrarte los eventos que hay cerca de ti."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9a6204e-55f9-4aad-bd09-779aa1bff298"
      }
    },
    "owner": "santiagosuescun07"
  }
}
