{
  "expo": {
    "name": "Tiked",
    "slug": "Clubhive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clubhive.app",
      "scheme": "tiked",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "Tiked",
        "CFBundleName": "Tiked",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "tiked",
              "com.googleusercontent.apps.reemplazar-con-client-id-ios"
            ]
          }
        ],
        "GIDClientID": "reemplazar-con-client-id-ios.apps.googleusercontent.com",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.clubhive.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withIosModularHeaders",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9a6204e-55f9-4aad-bd09-779aa1bff298"
      }
    },
    "owner": "santiagosuescun07"
  }
}
